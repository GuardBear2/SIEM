#!/bin/sh
# postinst script for GuardBear
# GuardBear, Inc 2015
set -e
case "$1" in
    configure)

        OS=$(lsb_release -si)
        VER=$(lsb_release -sr)
        GUARDBEAR_TMP_DIR="/tmp"
        OSMYSHELL="/sbin/nologin"

        if [ -d /run/systemd/system ]; then
            rm -f /etc/init.d/guardbear-server
        fi

        if [ ! -f ${OSMYSHELL} ]; then
            if [ -f "/bin/false" ]; then
                OSMYSHELL="/bin/false"
            fi
        fi

        # Remove old service file /etc/systemd/system/guardbear-server.service if present
        if [ -f /etc/systemd/system/guardbear-server.service ]; then
            rm -f /etc/systemd/system/guardbear-server.service
            if command -v systemctl > /dev/null 2>&1 && systemctl > /dev/null 2>&1; then
                systemctl daemon-reload > /dev/null 2>&1
            fi
        fi

        # Restart GuardBear manager
        if [ ! -z "$2" ]; then
            if [ -f ${GUARDBEAR_TMP_DIR}/guardbear.restart ] ; then
                if command -v systemctl > /dev/null 2>&1 && systemctl > /dev/null 2>&1; then
                    systemctl daemon-reload > /dev/null 2>&1
                    systemctl restart guardbear-server.service > /dev/null 2>&1
                elif command -v service > /dev/null 2>&1 ; then
                    service guardbear-server restart > /dev/null 2>&1
                fi
            fi
        fi
    ;;


    abort-upgrade|abort-remove|abort-deconfigure)

    ;;


    *)
        echo "postinst called with unknown argument \`$1'" >2
        exit 1
    ;;

esac

exit 0
