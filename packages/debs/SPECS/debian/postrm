#!/bin/sh
# postrm script for GuardBear
# GuardBear, Inc 2015
set -e

GUARDBEAR_USER="guardbear-server"
GUARDBEAR_GROUP="guardbear-server"

case "$1" in
    remove|failed-upgrade|abort-install|abort-upgrade|disappear)
        if [ -d "/run/guardbear-server" ]; then
            rm -rf /run/guardbear-server || true
        fi

    ;;

    purge)
        if getent passwd $GUARDBEAR_USER > /dev/null 2>&1 ; then
            deluser $GUARDBEAR_USER  > /dev/null 2>&1
        fi

        if getent group $GUARDBEAR_GROUP > /dev/null 2>&1; then
            delgroup $GUARDBEAR_GROUP  > /dev/null 2>&1
        fi

        if [ -d "/var/lib/guardbear-server/" ]; then
            rm -rf /var/lib/guardbear-server/ || true
        fi

        if [ -d "/run/guardbear-server" ]; then
            rm -rf /run/guardbear-server || true
        fi

        if [ -d "/etc/guardbear-server" ]; then
            rm -rf /etc/guardbear-server || true
        fi
    ;;

    upgrade)
    ;;

    *)
        echo "postrm called with unknown argument \`$1'" >&2
        exit 0

    ;;

esac

exit 0
