[Unit]
Description=GuardBear server
Wants=network-online.target
After=network.target network-online.target

[Service]
LimitNOFILE=65536
ExecStart=/usr/bin/env GUARDBEAR_HOME_TMPusr/share/guardbear-server/bin/guardbear-server start
Type=exec
KillSignal=SIGINT
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
