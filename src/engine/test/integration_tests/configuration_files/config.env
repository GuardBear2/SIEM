# TODO: Skip API configuration, remove after change workflow to use package
GUARDBEAR_CONFIG_SKIP_API=true

# Sets the logging level.
GUARDBEAR_LOG_LEVEL=error

# Sets the path to the folder where the assets are located (store).
GUARDBEAR_STORE_PATH=ENV_PATH_PLACEHOLDER/store

# Sets the path to the KVDB folder.
GUARDBEAR_KVDB_PATH=ENV_PATH_PLACEHOLDER/kvdb

# Sets configuration for the queue. (Disable flood, and disable drop on flood)
GUARDBEAR_QUEUE_SIZE=1000000
GUARDBEAR_QUEUE_FLOOD_FILE=
GUARDBEAR_QUEUE_DROP_ON_FLOOD=false

# Sets the number of threads to be used by the router.
GUARDBEAR_ORCHESTRATOR_THREADS=2

# Set the server configuration
GUARDBEAR_SERVER_THREAD_POOL_SIZE=2
GUARDBEAR_SERVER_EVENT_QUEUE_SIZE=0
GUARDBEAR_SERVER_API_SOCKET=ENV_PATH_PLACEHOLDER/queue/sockets/engine-api.socket
GUARDBEAR_SERVER_API_QUEUE_SIZE=300
GUARDBEAR_SERVER_API_TIMEOUT=10000
GUARDBEAR_SERVER_EVENT_SOCKET=ENV_PATH_PLACEHOLDER/queue/sockets/engine.socket

# Sets the install path to the time zone database.
GUARDBEAR_TZDB_PATH=ENV_PATH_PLACEHOLDER/tzdb
GUARDBEAR_TZDB_AUTO_UPDATE=false

GUARDBEAR_INDEXER_DB_PATH=ENV_PATH_PLACEHOLDER/indexer-connector
